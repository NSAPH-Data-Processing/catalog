{"type":"dataset","dataset_id":"lego.environmental.pm25_components__randall","dataset_version":"v0","name":"Randall PM2.5 Components","short_name":"PM2.5 Components Randall","description":"The Washu Atmospheric Composition Analysis Group uses a combination of satellite images, monitors and simulation to generate estimates of PM2.5 components including Black Carbon (BC), Dust, Ammonium (NH4), Nitrate (NO3), Organic Matter (OM), Hydrated Organic Matter (OM+H2O), Sulfate (SO4), and Sea Salt (SS). Estimates are available monthly and yearly at ZCTA and county levels. Data are provided for two algorithm versions: V5NA (2000–2022) and V6NA (1998–2023).","doi":"","url":["https://github.com/NSAPH-Data-Processing/pm25_components_randall_raster2polygon"],"license":{"name":"CC BY 4.0","url":"https://creativecommons.org/licenses/by/4.0/"},"authors":[{"givenName":"Shreya","familyName":"Nalluri","email":"snalluri@hsph.harvard.edu"}],"access_request_url":"","keywords":["air pollution","exposure","pm25","pm25 components","black carbon","dust","ammonium","nitrate","organic matter","sulfate","sea salt"],"funding":[],"publications":[],"subdatasets":[{"dataset_id":"lego.environmental.pm25_components__randall.v5na.zcta_monthly","dataset_version":"v0","dataset_path":"V5NA/zcta_monthly/pm25_components__V5NA__randall__zcta_monthly__yyyy.parquet"},{"dataset_id":"lego.environmental.pm25_components__randall.v5na.zcta_yearly","dataset_version":"v0","dataset_path":"V5NA/zcta_yearly/pm25_components__V5NA__randall__zcta_yearly__yyyy.parquet"},{"dataset_id":"lego.environmental.pm25_components__randall.v5na.county_monthly","dataset_version":"v0","dataset_path":"V5NA/county_monthly/pm25_components__V5NA__randall__county_monthly__yyyy.parquet"},{"dataset_id":"lego.environmental.pm25_components__randall.v5na.county_yearly","dataset_version":"v0","dataset_path":"V5NA/county_yearly/pm25_components__V5NA__randall__county_yearly__yyyy.parquet"},{"dataset_id":"lego.environmental.pm25_components__randall.v6n